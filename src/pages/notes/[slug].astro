---
import Layout from '../../layouts/Layout.astro';
import { site, notes, type Note } from '../../data/site';

export function getStaticPaths() {
  return notes.map((n) => ({ params: { slug: n.slug }, props: { note: n } }));
}

interface Props {
  note: Note;
}
const { note } = Astro.props;
---

<Layout title={`${note.title} | ${site.name}`} description={note.summary}>
  <div class="container detail">
    <a class="back-link" href="/#notes">← 返回笔记</a>

    <header class="detail-head">
      <span class="eyebrow">{note.category} / {note.date}</span>
      <h1>{note.title}</h1>
      <p class="detail-sub">{note.summary}</p>
    </header>

    <div class="prose">
      {note.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</Layout>
