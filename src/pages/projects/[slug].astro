---
import Layout from '../../layouts/Layout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { site } from '../../data/site';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);

const [name, tagline] = project.data.title.split(/\s+—\s+/);
---

<Layout title={`${name} — ${tagline ?? ''} | ${site.name}`} description={project.data.description}>
  <div class="container detail">
    <a class="back-link" href="/#projects">← 返回项目</a>

    <header class="detail-head" data-reveal>
      <span class="eyebrow">PROJECT / {name.toUpperCase()}</span>
      <h1>{tagline ?? project.data.title}</h1>
      <p class="detail-sub">{project.data.description}</p>
      <div class="detail-meta">
        <ul class="tags">
          {project.data.tags.map((t) => <li>{t}</li>)}
        </ul>
        {project.data.repo ? (
          <a class="link" href={project.data.repo} rel="noopener noreferrer">源码 ↗</a>
        ) : (
          <span class="pending">源码链接待补充</span>
        )}
        {project.data.url && (
          <a class="link" href={project.data.url} rel="noopener noreferrer">在线访问 ↗</a>
        )}
      </div>
    </header>

    <div class="detail-art" data-reveal>
      {project.data.cover ? (
        <img src={project.data.cover} alt={`${name} 界面截图`} />
      ) : (
        <ProjectArtwork art={project.data.artwork} />
      )}
    </div>

    <div class="prose">
      <Content />
    </div>
  </div>
</Layout>
