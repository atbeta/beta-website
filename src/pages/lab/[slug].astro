---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import { site, experiments, type Experiment } from '../../data/site';

export function getStaticPaths() {
  return experiments.map((e) => ({ params: { slug: e.slug }, props: { experiment: e } }));
}

interface Props {
  experiment: Experiment;
}
const { experiment } = Astro.props;
---

<Layout title={`${experiment.title} — 数字实验室 | ${site.name}`} description={experiment.description}>
  <div class="container detail">
    <a class="back-link" href="/#lab">← 返回实验室</a>

    <header class="detail-head">
      <span class="eyebrow">EXPERIMENT / {experiment.mode.toUpperCase()}</span>
      <h1>{experiment.title}</h1>
      <p class="detail-sub">{experiment.description}</p>
      <div class="detail-meta">
        <ul class="tags">
          {experiment.tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </header>

    <div class="lab-stage">
      <Scene
        mode={experiment.mode}
        caption={`LAB / ${experiment.slug.toUpperCase()}`}
      />
    </div>

    <div class="prose">
      <p>
        这是一个可交互的小实验：画布支持拖动旋转，下方工具栏可以暂停动画或调整参数。
        如果看不到画面，可能是浏览器不支持 WebGL，占位示意图会继续显示。
      </p>
    </div>
  </div>
</Layout>
